# Variables de entorno de ejemplo para GalacticApp Frontend.
# Copiá este archivo como .env y completá los valores.

# URL base de la API, terminada en /api.
# Desarrollo con el backend corriendo en tu PC: http://localhost:3000/api
# Con Docker (nginx reenvía /api al backend): /api
VITE_API_URL=http://localhost:3000/api

# true para usar datos simulados, sin backend.
VITE_USE_MOCKS=false
